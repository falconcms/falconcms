# Normalise line endings in the repository, whatever the contributor's OS does locally.
# Without this, every file touched on Windows shows up as fully rewritten in a diff.
* text=auto eol=lf

*.php      text eol=lf
*.blade.php text eol=lf
*.js       text eol=lf
*.css      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.neon     text eol=lf
*.yml      text eol=lf
*.xml      text eol=lf

*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.svg      text eol=lf
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary

# Keep the distributed package small: none of this is needed at runtime.
/docs               export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/pint.json          export-ignore
