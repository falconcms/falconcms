includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 3

    paths:
        - src
        - database
        - routes
        - tests
        - plugins/falcon-shop/src
        - plugins/falcon-seo/src

    # helpers.php and src/helpers/ are the procedural template helpers (the WordPress-style
    # API themes call). They are not analysed — but they ARE scanned, so every falcon_*()
    # call site elsewhere resolves to a real signature instead of "function not found".
    excludePaths:
        - src/helpers.php
        - src/helpers
        - plugins/falcon-shop/src/helpers
        - plugins/falcon-seo/src/helpers

    scanFiles:
        - src/helpers.php

    scanDirectories:
        - src/helpers

    # A plugin's helpers are not autoloaded by Composer; the bootstrap declares them.
    # The CMS's own user abilities on Laravel's base User (see the stub).
    stubFiles:
        - phpstan-stubs/User.stub

    bootstrapFiles:
        - phpstan-bootstrap.php
